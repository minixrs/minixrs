# tests/qemu-boot.disk.expected -- substrings required IN ADDITION to
# tests/qemu-boot.expected when the boot disk carries the root partition
# (MINIXRS_ROOT=disk, the default). Same format as that file.
# tools/check-boot-log.sh disk <log> checks both.
#
# Since slice 6.4 the machine boots from one GPT disk image (tools/mkimage: a
# FAT32 ESP and the MinixFS root partition) attached as a single virtio-blk
# device, and BOTH boots attach one -- the ramdisk boot's image merely has no
# root partition. So the device's own bring-up lines below are required by
# tests/qemu-boot.ramdisk.expected as well; they are listed in each per-backend
# file, not in the common one, because the hand-run MINIXRS_ROOT=nodisk boot
# has none of them and still passes the common set. What only THIS file holds is
# what exists because the disk carries a ROOT: `root ok`, the flush, and MFS's
# choice of `vblk`.
#
# Everything the filesystem proves -- mount, read, write, create/truncate, the
# hole probe, exec from the root -- is in the COMMON file and is therefore
# required of both backends.

# virtio-blk, the first consumer of driver-rt (spec T4, T5, T7, T12). The kernel's
# boot probe finds the disk tools/qemu-run.sh pins to bus 0 -- transport slot 0,
# PA 0xa000000 (measured, spec T14) -- and assigns it to vblk; `ver=2` is the
# modern transport `-global virtio-mmio.force-legacy=false` selects.
[virtio] slot=0 pa=0xa000000 id=2 ver=2 drv=vblk

# The register page, asserted whole: every value follows from the bus pinning in
# tools/qemu-run.sh (BUS_VBLK=0 -> slot 0 -> PA 0xa000000, in-page offset 0, INTID
# 48 + 0 = 48), mapped at VIRTIO_MMIO_PAGE_VA (0x40001000). A prefix would also
# match va=0x40000000 -- TTY's UART page, the off-by-one-page mapping this line
# exists to catch.
[devmap] vblk va=0x40001000 pa=0xa000000 intid=48

# The 16-page DMA run at DMA_VA. va= and pages= are asserted; pa= follows them and
# is not. pa= read 0x40000000 in every local boot, stub-free and default -- the
# probe's reservation is the first bump from the first usable region -- but that
# region's base comes from the firmware's memory map, which CI's edk2 build may
# draw differently (the reason ttbr0_pa is never asserted either). pages= is
# printed before pa= precisely so the run size is pinned: a wrong size also
# trips the driver, whose `vblk_layout` refuses a run without its three pages
# (`virtio FAIL step=queue`, forbidden).
[dma] vblk va=0xc0000000 pages=16

# The driver's verdict on T12's eight steps: the mapping, the DMA cookie (VA and PA
# name the same memory), the magic/version/DeviceID, the negotiation, the
# generation-stable capacity read, queue 0 enabled at the run's PA with DRIVER_OK
# read back, and its interrupt claim plus the INTID+1 refusal. features= is exactly
# VIRTIO_F_VERSION_1 (bit 32) | VIRTIO_BLK_F_FLUSH (bit 9), measured on QEMU
# 11.0.3 with a writable raw drive (slice 6.4, spec P8/P11.4). The driver asks
# for two optional bits, F_FLUSH and F_RO (bit 5); a writable drive does not
# offer F_RO, so 0x...220 here would be a read-only disk and any other bit
# something the negotiation was not asked for. capacity= is the WHOLE disk in
# 512-byte sectors -- 37 MiB: the 1 MiB GPT lead-in, the 34 MiB ESP, the 1 MiB
# root partition and the backup GPT, rounded up to a multiple of 8 -- every
# term derived from constants in tools/mkimage, and the same on the rootless
# image. qsize= is driver-rt's QUEUE_SIZE (8) under the device's QueueNumMax.
# slot= is not asserted. A failing step prints `virtio FAIL step=<step>` instead
# (forbidden).
[diag vblk] virtio ok features=0x100000200 capacity=75776 qsize=8

# The root check (slice 6.3, spec B6; moved onto the partition in slice 6.4,
# spec P5-P7). After bring-up the driver reads the GPT -- blocks 0-4 of the
# whole disk -- THROUGH THE QUEUE, each read completed by a real interrupt it
# blocked in receive for, selects the one partition carrying the root type GUID
# (kernel-shared's ROOT_PARTITION_TYPE_GUID), and applies the memory driver's
# device-level checks to THAT extent: the image label in its first block, the
# header's block count against the partition's, and the tail label in its last
# block. blocks= is the partition's size (ROOTFS_IMAGE_BLOCKS = 256). part=2 is
# the GPT entry, counted from 1 (the ESP is 1). lba=71680 is the partition's
# first sector -- 35 MiB in, the first 1 MiB boundary after the ESP -- and is
# asserted because it is the proof that the root's block 0 is NOT the disk's:
# a driver that dropped the extent base would read the protective MBR and print
# `root FAIL label`. The line is printed whole and asserted whole.
# These reads are also the first proof that the DMA run's data page is the
# memory the device writes (the 6.2 cookie proved only the run's first page).
# Mutation-tested in 6.3: dropping the IRQ re-arm hangs the boot before this
# line, and addressing sector = block (not 8 * block) fails the check.
[diag vblk] root ok blocks=256 tail=1 part=2 lba=71680

# Slice 6.4: the flush (spec P8). The device accepted VIRTIO_BLK_F_FLUSH, so
# every BDEV_WRITE that reached it is followed by a VIRTIO_BLK_T_FLUSH before
# the reply. The first one that succeeds prints this line, once (n= is the
# driver's own count at that moment, never a running total). It shows that a
# write reached the device and that the flush request completed with status 0
# -- not that anything reached stable storage, which a raw image under QEMU
# cannot show. The ramdisk boot FORBIDS it: a disk with no root is never written.
[diag vblk] flush ok n=1

# Slice 6.3: MFS chose the disk (spec B1/B2, phase decision H5). It found `vblk`
# in DS, probed it with one zero-length read, and mounted its root through it.
# This line, with tests/qemu-boot.disk.forbidden's `name=memory`, is what closes
# H5's silent fallback: a broken virtio path that fell back to the ramdisk would
# otherwise pass every filesystem marker.
[diag mfs] bdev.ds ok name=vblk ep=

# Slice 6.4: the minor table, opened once (spec P6). The driver serves minor 0
# (the root partition), minor 1 (the whole disk) and minor 1+n (GPT partition
# n), and the filesystem only ever opens minor 0 -- so MFS's prologue issues the
# system's one request for another minor: a whole-block BDEV_READ of block 0 of
# minor 1. That block starts with LBA 0, and the line is printed only if the
# reply was one whole block carrying a PROTECTIVE MBR: the 55 AA boot signature
# at offset 510, a first partition record of type 0xEE at offset 450, and not
# the root image's label at offset 0 (minixrs_mfs::minor::classify, host-
# tested). The root partition's block 0 has zeroes at both offsets, and the
# ESP's has the signature but no 0xEE record, so a driver that answered minor 1
# from either extent prints `bdev.minor FAIL mbr` instead (forbidden; both were
# run -- spec mutation 11 is the root case, and the ESP case showed that
# without the 0xEE check the probe reports a false `ok`). minor= is
# BDEV_MINOR_WHOLE_DISK, the constant the driver's table is built from. The
# ramdisk boot FORBIDS this line and requires `absent`.
[diag mfs] bdev.minor ok minor=1 mbr=1
